<!--pages/personas/personas.wxml-->
<view class="container">
  <view class="page-intro">
    <view class="page-title">创始人画像</view>
    <view class="page-sub">基于访谈与语料库，沉淀决策案例与价值偏好</view>
  </view>

  <view class="persona-list">
    <view 
      class="persona-card" 
      wx:for="{{personas}}" 
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onPersonaTap"
    >
      <view class="persona-avatar">
        <text class="avatar-letter">{{item.name[0]}}</text>
        <view class="avatar-type" style="background: {{item.type === 'fictional' ? '#b06000' : '#1a73e8'}};">
          {{item.type === 'fictional' ? '虚构' : '真实'}}
        </view>
      </view>
      <view class="persona-info">
        <view class="persona-name">{{item.name}}</view>
        <view class="persona-role">{{item.role}}</view>
        <view class="persona-bio">{{item.bio}}</view>
        <view class="persona-tags" wx:if="{{item.tags.length > 0}}">
          <text class="tag tag-gray" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
        </view>
        <view class="persona-evidence" wx:if="{{item.evidence.length > 0}}">
          <text class="ev-icon">📚</text>
          <text class="ev-count">{{item.evidence.length}} 条决策案例</text>
        </view>
        <view class="persona-evidence empty" wx:else>
          <text class="ev-icon">📭</text>
          <text class="ev-count">知识库待补充</text>
        </view>
      </view>
      <view class="persona-arrow">›</view>
    </view>
  </view>
</view>
