/* pages/history/history.wxss */

.filter-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 28rpx;
  padding: 8rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.filter-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #5f6368;
  font-weight: 500;
  transition: all 0.2s;
}

.filter-btn.active {
  background: #1a1a2e;
  color: #ffffff;
}

.filter-btn.active.orange {
  background: #ff9800;
}

.filter-btn.active.gray {
  background: #9e9e9e;
}

.interview-list {
  margin-bottom: 32rpx;
}

.interview-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.interview-card:active {
  background: #f8f9fa;
}

.interview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.interview-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.interview-meta {
  font-size: 24rpx;
  color: #80868b;
  margin-bottom: 12rpx;
}

.meta-persona {
  font-weight: 500;
  color: #5f6368;
}

.meta-dot {
  margin: 0 8rpx;
  color: #dadce0;
}

.interview-preview {
  font-size: 24rpx;
  color: #5f6368;
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.interview-footer {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f3f4;
}

.metric {
  flex: 1;
  text-align: center;
}

.metric-label {
  font-size: 20rpx;
  color: #80868b;
  margin-bottom: 4rpx;
}

.metric-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.metric-divider {
  width: 1rpx;
  height: 40rpx;
  background: #e8eaed;
}
