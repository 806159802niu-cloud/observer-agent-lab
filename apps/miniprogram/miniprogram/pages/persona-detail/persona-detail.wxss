/* pages/persona-detail/persona-detail.wxss */

/* Profile header */
.profile-header {
  position: relative;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #ffffff20;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-letter {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
}

.profile-info {
  flex: 1;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.profile-role {
  font-size: 24rpx;
  opacity: 0.75;
  margin-bottom: 8rpx;
}

.profile-style {
  font-size: 24rpx;
  opacity: 0.6;
}

.style-label {
  opacity: 0.5;
}

.profile-type-badge {
  font-size: 22rpx;
  color: #ffffff;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  position: absolute;
  top: 24rpx;
  right: 24rpx;
}

/* Bio card */
.profile-bio {
  padding: 28rpx 32rpx;
}

.bio-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #80868b;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.bio-text {
  font-size: 28rpx;
  color: #1a1a2e;
  line-height: 1.7;
}

/* Tags section */
.tags-section {
  margin-bottom: 16rpx;
}

/* Section title */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5f6368;
  margin: 32rpx 0 16rpx;
  padding-left: 8rpx;
}

/* Evidence cards */
.evidence-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.evidence-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.evidence-id {
  font-size: 22rpx;
  font-weight: 700;
  color: #1a73e8;
  letter-spacing: 1rpx;
}

.evidence-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.evidence-content {
  font-size: 26rpx;
  color: #3c4043;
  line-height: 1.7;
  margin-bottom: 16rpx;
}

.evidence-tags {
  display: flex;
  flex-wrap: wrap;
}

/* Empty */
.empty {
  text-align: center;
  padding: 80rpx 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #5f6368;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #80868b;
}
