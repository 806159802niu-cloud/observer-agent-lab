/* pages/interview/interview.wxss */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f7f9;
}

/* 顶部状态栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e8eaed;
}

.top-bar-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.persona-tag {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a2e;
}

.mode-tag {
  font-size: 22rpx;
}

.progress {
  background: #f1f3f4;
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #5f6368;
  font-weight: 500;
}

/* 对话区 */
.chat-area {
  flex: 1;
  padding: 24rpx 24rpx 200rpx;
}

/* 轮次块 */
.round-block {
  margin-bottom: 32rpx;
}

.round-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.round-num {
  font-size: 22rpx;
  color: #80868b;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.round-score {
  font-size: 24rpx;
  font-weight: 600;
}

/* 发言气泡 */
.utterance-row {
  display: flex;
  margin-bottom: 20rpx;
  align-items: flex-start;
}

.utterance-row.interviewer {
  flex-direction: row;
}

.utterance-row.respondent {
  flex-direction: row-reverse;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 500;
  flex-shrink: 0;
  margin: 0 16rpx;
}

.bubble-wrapper {
  max-width: 75%;
}

.bubble {
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  position: relative;
}

.bubble.interviewer {
  background: #1a73e8;
  color: #ffffff;
  border-top-left-radius: 8rpx;
}

.bubble.respondent {
  background: #ffffff;
  color: #1a1a2e;
  border: 1rpx solid #e8eaed;
  border-top-right-radius: 8rpx;
}

.speaker-name {
  display: block;
  font-size: 22rpx;
  margin-bottom: 6rpx;
  opacity: 0.7;
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.65;
}

.bubble.respondent .bubble-text {
  white-space: pre-wrap;
}

/* Hint 展开区 */
.hint-preview {
  display: flex;
  align-items: center;
  background: #fff8e1;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-top: 16rpx;
}

.hint-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.hint-label {
  flex: 1;
  font-size: 24rpx;
  color: #b06000;
}

.hint-arrow {
  font-size: 32rpx;
  color: #b06000;
  transition: transform 0.2s;
}

.hint-arrow.expanded {
  transform: rotate(90deg);
}

.hint-full {
  background: #fffef7;
  border: 1rpx solid #ffe082;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 8rpx;
}

.hint-section {
  margin-bottom: 16rpx;
}

.hint-section:last-child {
  margin-bottom: 0;
}

.hint-section-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #b06000;
  margin-bottom: 8rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #5f6368;
  line-height: 1.7;
}

.hint-text.depth {
  color: #188038;
}

/* 完成态 */
.completion {
  text-align: center;
  padding: 80rpx 32rpx;
}

.completion-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.completion-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.completion-desc {
  font-size: 26rpx;
  color: #80868b;
  margin-bottom: 40rpx;
}

.completion-actions {
  display: flex;
  gap: 24rpx;
  justify-content: center;
}

.completion-actions .btn-secondary,
.completion-actions .btn-primary {
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}

/* 观察者实时面板 */
.observer-panel {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 140rpx;
  background: #fffef7;
  border: 1rpx solid #ffe082;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.observer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #ffd54f 0%, #ffb300 100%);
}

.observer-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #5d4037;
}

.observer-icon {
  font-size: 28rpx;
}

.observer-score-badge {
  font-size: 36rpx;
  font-weight: 700;
  background: #ffffff;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}

.observer-body {
  padding: 20rpx 24rpx;
  max-height: 280rpx;
  overflow-y: auto;
}

.observer-section {
  margin-bottom: 16rpx;
}

.observer-section:last-child {
  margin-bottom: 0;
}

.observer-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #b06000;
  margin-bottom: 6rpx;
}

.observer-text {
  font-size: 26rpx;
  color: #5f6368;
  line-height: 1.7;
}

.observer-text.depth {
  color: #188038;
}

/* 关键转折高亮（第 7 轮） */
.observer-panel.observer-panel-hot {
  border: 3rpx solid #ff9800;
  box-shadow: 0 8rpx 32rpx rgba(255, 152, 0, 0.25);
  animation: slideUp 0.3s ease-out, glow 2s ease-in-out infinite;
}

@keyframes glow {
  0%, 100% { box-shadow: 0 8rpx 32rpx rgba(255, 152, 0, 0.25); }
  50% { box-shadow: 0 8rpx 48rpx rgba(255, 152, 0, 0.45); }
}

.observer-panel.observer-panel-hot .observer-header {
  background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%);
}

/* 底部控制栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e8eaed;
}

.ctrl-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 22rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.auto-btn {
  background: #f1f3f4;
  color: #5f6368;
  border: 2rpx solid transparent;
}

.auto-btn.active {
  background: #e8f0fe;
  color: #1a73e8;
  border-color: #1a73e8;
}

.next-btn {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  color: #ffffff;
}

.next-btn.done {
  background: #188038;
}

.ctrl-icon {
  font-size: 28rpx;
}

.ctrl-label {
  font-size: 28rpx;
}
