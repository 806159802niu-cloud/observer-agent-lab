/* pages/interviewer/interviewer.wxss */
.container {
  padding: 24rpx 28rpx 60rpx;
  background: #f7f7f9;
  min-height: 100vh;
}

/* 顶部卡片 */
.header-card {
  background: linear-gradient(135deg, #1a1a2e 0%, #3d3d5c 100%);
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  color: #fff;
  margin-bottom: 32rpx;
}
.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.header-badge {
  background: rgba(255,255,255,0.15);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.header-status {
  font-size: 22rpx;
  color: #ffd166;
  background: rgba(255, 209, 102, 0.15);
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}
.header-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.header-position {
  font-size: 26rpx;
  color: #a0a0c0;
  margin-bottom: 12rpx;
}
.header-desc {
  font-size: 24rpx;
  color: #8c8ca8;
  line-height: 1.6;
}

/* 分组 */
.group {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}
.group-arrow {
  font-size: 32rpx;
  color: #999;
  transition: transform 0.2s;
  transform: rotate(90deg);
}
.group-arrow.open {
  transform: rotate(-90deg);
}

/* 治理三层 */
.levels-grid {
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.level-card {
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}
.level-value { background: #e8f0fe; border-left: 4rpx solid #1a73e8; }
.level-structure { background: #e6f4ea; border-left: 4rpx solid #188038; }
.level-parameters { background: #fef7e0; border-left: 4rpx solid #b06000; }
.level-name {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.level-value .level-name { color: #1a73e8; }
.level-structure .level-name { color: #188038; }
.level-parameters .level-name { color: #b06000; }
.level-desc {
  font-size: 24rpx;
  color: #555;
  line-height: 1.6;
}

/* 关键词闭环 */
.keyword-section {
  padding: 24rpx 28rpx;
}
.keyword-hint {
  font-size: 24rpx;
  color: #666;
  background: #f8f8ff;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  line-height: 1.6;
}
.keyword-loop-wrap {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 24rpx;
}
.loop-node {
  display: flex;
  align-items: center;
}
.loop-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #1a1a2e;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
}
.loop-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
}
.loop-arrow {
  color: #aaa;
  font-size: 28rpx;
  margin: 0 12rpx;
}
.summary-title, .design-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin: 16rpx 0 8rpx;
}
.summary-item, .design-item {
  font-size: 22rpx;
  color: #555;
  line-height: 1.7;
}

/* 十项标准 */
.standards-list {
  padding: 16rpx 28rpx 24rpx;
}
.standard-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.standard-item:last-child { border-bottom: none; }
.std-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
}
.std-id {
  width: 48rpx;
  height: 48rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #1a1a2e, #3d3d5c);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.std-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a2e;
}
.std-criterion {
  font-size: 24rpx;
  color: #555;
  line-height: 1.6;
  padding-left: 62rpx;
}

/* 15 模式 */
.patterns-list {
  padding: 16rpx 28rpx 24rpx;
}
.pattern-item {
  margin-bottom: 16rpx;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  overflow: hidden;
}
.pattern-head {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fafafa;
}
.pattern-id {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #1a1a2e, #3d3d5c);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.pattern-name {
  flex: 1;
  font-size: 25rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
}
.pattern-expand {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
}
.pattern-detail {
  padding: 16rpx 20rpx;
  background: #fff;
}
.pd-row {
  margin-bottom: 12rpx;
  font-size: 23rpx;
  color: #444;
  line-height: 1.6;
}
.pd-row:last-child { margin-bottom: 0; }
.pd-label {
  display: inline-block;
  font-weight: 600;
  color: #1a1a2e;
  margin-right: 10rpx;
}
.source-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #1a73e8;
  background: #e8f0fe;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  margin-top: 4rpx;
}

/* 压力测试 */
.pressures-list {
  padding: 16rpx 28rpx 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.pressure-item {
  flex: 1;
  min-width: 45%;
  background: #fff8e1;
  border: 1rpx solid #ffe082;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.pressure-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #8d6e00;
  margin-bottom: 6rpx;
}
.pressure-example {
  font-size: 22rpx;
  color: #555;
  line-height: 1.5;
}

/* 规则层 */
.rule-layers-list {
  padding: 16rpx 28rpx 24rpx;
}
.rule-layer-item {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.rule-layer-item:last-of-type { border-bottom: none; }
.rl-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1a1a2e;
  width: 150rpx;
  flex-shrink: 0;
}
.rl-question {
  flex: 1;
  font-size: 23rpx;
  color: #555;
  line-height: 1.5;
}
.trial-box {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #3d3d5c 100%);
  border-radius: 14rpx;
  padding: 24rpx;
  color: #fff;
}
.trial-header {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffd166;
  margin-bottom: 8rpx;
}
.trial-status {
  font-size: 22rpx;
  color: #a0a0c0;
  margin-bottom: 14rpx;
}
.trial-quote {
  font-size: 26rpx;
  color: #e0e0f0;
  line-height: 1.7;
  font-style: italic;
  background: rgba(255,255,255,0.06);
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
}

/* 案例卡 */
.case-cards {
  padding: 16rpx 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.case-card {
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  overflow: hidden;
}
.case-head {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fafafa;
}
.case-name {
  flex: 1;
  font-size: 25rpx;
  font-weight: 600;
  color: #333;
}
.case-source {
  font-size: 22rpx;
  color: #1a73e8;
  background: #e8f0fe;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}
.case-expand {
  font-size: 22rpx;
  color: #999;
}
.case-detail {
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}

/* 诊断步骤 */
.diagnostic-list {
  padding: 16rpx 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.diag-item {
  display: flex;
  align-items: flex-start;
}
.diag-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #188038, #2e7d32);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}
.diag-text {
  font-size: 24rpx;
  color: #444;
  line-height: 1.6;
  flex: 1;
}

/* 口语替换 */
.oral-list {
  padding: 16rpx 28rpx 24rpx;
}
.oral-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.oral-item:last-child { border-bottom: none; }
.oral-written {
  flex: 1;
  font-size: 24rpx;
  color: #888;
  text-decoration: line-through;
}
.oral-arrow {
  margin: 0 16rpx;
  color: #ccc;
  font-size: 28rpx;
}
.oral-speaking {
  flex: 1;
  font-size: 24rpx;
  font-weight: 500;
  color: #188038;
}

/* 底部备注 */
.footer-note {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 40rpx;
}
