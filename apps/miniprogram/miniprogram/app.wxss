/* app.wxss - 全局样式 */
page {
  background-color: #f7f7f9;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1a1a2e;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 32rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  color: #ffffff;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  text-align: center;
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

/* 次要按钮 */
.btn-secondary {
  background: #ffffff;
  color: #1a1a2e;
  border: 2rpx solid #1a1a2e;
  border-radius: 48rpx;
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  text-align: center;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-blue {
  background: #e8f0fe;
  color: #1a73e8;
}

.tag-green {
  background: #e6f4ea;
  color: #188038;
}

.tag-orange {
  background: #fef7e0;
  color: #b06000;
}

.tag-red {
  background: #fce8e6;
  color: #c5221f;
}

.tag-gray {
  background: #f1f3f4;
  color: #5f6368;
}

/* 标题层级 */
.h1 {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}

.h2 {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.h3 {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.body {
  font-size: 28rpx;
  color: #3c4043;
  line-height: 1.7;
}

.caption {
  font-size: 24rpx;
  color: #80868b;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #e8eaed;
  margin: 24rpx 0;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #80868b;
}

/* 发言人头像色 */
.avatar-interviewer {
  background: #1a73e8;
}

.avatar-respondent {
  background: #188038;
}

.avatar-observer {
  background: #b06000;
}
